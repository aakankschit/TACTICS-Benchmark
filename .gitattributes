# Reference score tables: large binary, tracked with Git LFS.
*.parquet filter=lfs diff=lfs merge=lfs -text

# OpenEye design units: binary.
*.oedu filter=lfs diff=lfs merge=lfs -text

# Text data kept in plain git so it stays diffable and greppable.
*.smi  text
*.pdb  text
*.sdf  text
*.md   text

# reactions.csv is a verbatim mirror of the canonical source: store the bytes
# exactly as they are, including its CRLF line endings.
*.csv  -text
